{%- comment -%}
==============================================================================
  Otterseas Packing Slip — Shopify Order Printer template
==============================================================================
  Centred hero (logo + Thank you, {name} + tagline), then a clean order
  block, items table with product thumbnails, total, OTTERLOVE20 banner,
  footer.

  How to use:
  1. In Shopify admin → Apps → Order Printer → Templates → New
  2. Paste the entire contents of this file into the template body
  3. Save and set as the default packing-slip template (optional)

  Tuned for A4. Single page in almost all cases.
==============================================================================
{%- endcomment -%}

<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Packing Slip · {{ order.name }}</title>
<style>
  @page { size: A4 portrait; margin: 14mm; }
  * { box-sizing: border-box; }
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #1a1a1a;
    margin: 0;
    padding: 0;
    font-size: 10.5pt;
    line-height: 1.5;
  }
  .page { width: 100%; max-width: 182mm; margin: 0 auto; }

  /* ---------- Hero (centred logo + thank you + tagline) ---------- */
  .hero {
    text-align: center;
    padding: 4mm 0 8mm;
    border-bottom: 1.5px solid #023859;
    margin-bottom: 22px;
  }
  .hero img.logo {
    width: 90px;
    height: 90px;
    margin: 0 auto 12px;
    display: block;
    object-fit: contain;
  }
  .hero .thank-you {
    font-size: 22pt;
    font-weight: 700;
    color: #023859;
    margin: 0 0 6px;
    line-height: 1.1;
  }
  .hero .thank-you .otter { font-size: 18pt; vertical-align: -1px; margin-left: 4px; }
  .hero .tagline {
    font-size: 8pt;
    letter-spacing: 0.32em;
    color: #54ACBF;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* ---------- Order meta row ---------- */
  .order-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 22px;
    font-size: 10pt;
  }
  .order-meta .item .label {
    font-size: 7pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
    margin-right: 8px;
  }
  .order-meta .item .value {
    color: #023859;
    font-weight: 700;
    font-size: 11pt;
  }

  /* ---------- Two-column meta (Ship to + Order details) ---------- */
  .meta-grid {
    display: flex;
    gap: 24px;
    margin-bottom: 24px;
  }
  .meta-block { flex: 1; }
  .meta-block h3 {
    font-size: 8pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #023859;
    font-weight: 700;
    margin: 0 0 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid #023859;
  }
  .meta-block p { margin: 2px 0; font-size: 10.5pt; color: #1a1a1a; }

  /* ---------- Items table ---------- */
  .items-section h3 {
    font-size: 8pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #023859;
    font-weight: 700;
    margin: 0 0 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid #023859;
  }
  table.items { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
  table.items th {
    text-align: left;
    font-size: 8pt;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
    padding: 8px 4px;
    border-bottom: 1px solid #ddd;
  }
  table.items th.thumb { width: 48px; }
  table.items th.qty { text-align: center; width: 60px; }
  table.items th.price { text-align: right; width: 80px; }
  table.items td {
    padding: 10px 4px;
    border-bottom: 1px dotted #ddd;
    font-size: 10.5pt;
    vertical-align: middle;
  }
  table.items td.thumb {
    width: 48px;
    padding: 6px 8px 6px 0;
  }
  table.items td.thumb .img-wrap {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: #f5f3ee;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  table.items td.thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  table.items td.qty { text-align: center; color: #555; }
  table.items td.price { text-align: right; font-weight: 600; }
  table.items .variant { display: block; font-size: 9pt; color: #777; margin-top: 2px; }

  /* ---------- Total ---------- */
  .total-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
  }
  .total-row .total-box {
    min-width: 200px;
    border-top: 2px solid #023859;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .total-row .label {
    font-size: 9pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #023859;
    font-weight: 700;
  }
  .total-row .amount {
    font-size: 14pt;
    font-weight: 800;
    color: #023859;
  }

  /* ---------- Repeat-customer discount banner ---------- */
  .discount {
    margin: 24px 0 26px;
    padding: 14px 18px;
    border: 1.5px dashed #54ACBF;
    border-radius: 6px;
    background: #54ACBF0D;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .discount .icon { font-size: 22pt; line-height: 1; }
  .discount .body { flex: 1; }
  .discount .label {
    font-size: 8pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #54ACBF;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .discount .copy { color: #023859; font-size: 10.5pt; }
  .discount .code {
    font-family: 'Courier New', monospace;
    background: #023859;
    color: white;
    padding: 3px 10px;
    border-radius: 3px;
    font-weight: 700;
    font-size: 11pt;
    letter-spacing: 0.12em;
    margin: 0 2px;
  }

  /* ---------- Footer ---------- */
  .footer {
    margin-top: 30px;
    padding-top: 14px;
    border-top: 1px solid #ddd;
    text-align: center;
    font-size: 9pt;
    color: #666;
  }
  .footer .row { margin-bottom: 4px; }
  .footer .support a { color: #023859; font-weight: 600; text-decoration: none; }
  .footer .brand {
    margin-top: 10px;
    font-size: 8pt;
    letter-spacing: 0.32em;
    color: #023859;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
</head>
<body>
<div class="page">

  {%- comment -%} ---- Hero: logo + thank you + tagline ---- {%- endcomment -%}
  <div class="hero">
    <img src="https://otterseas.com/logo.png" alt="Otterseas" class="logo">
    <h1 class="thank-you">
      Thank you, {{ order.customer.first_name | default: "diver" }}.<span class="otter">🦦</span>
    </h1>
    <div class="tagline">Made by a diver, for divers</div>
  </div>

  {%- comment -%} ---- Order meta row ---- {%- endcomment -%}
  <div class="order-meta">
    <div class="item">
      <span class="label">Order</span><span class="value">{{ order.name }}</span>
    </div>
    <div class="item">
      <span class="label">Date</span><span class="value">{{ order.created_at | date: "%-d %B %Y" }}</span>
    </div>
  </div>

  {%- comment -%} ---- Two-column: ship to + summary ---- {%- endcomment -%}
  <div class="meta-grid">
    <div class="meta-block">
      <h3>Ship to</h3>
      <p><strong>{{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}</strong></p>
      <p>{{ order.shipping_address.address1 }}</p>
      {%- if order.shipping_address.address2 -%}
        <p>{{ order.shipping_address.address2 }}</p>
      {%- endif -%}
      <p>
        {{ order.shipping_address.city }}{% if order.shipping_address.province %}, {{ order.shipping_address.province }}{% endif %} {{ order.shipping_address.zip }}
      </p>
      <p>{{ order.shipping_address.country }}</p>
    </div>
    <div class="meta-block">
      <h3>Order summary</h3>
      <p><strong>Order:</strong> {{ order.name }}</p>
      <p><strong>Date:</strong> {{ order.created_at | date: "%-d %B %Y" }}</p>
      <p><strong>Items:</strong> {{ order.line_items | sum: "quantity" }}</p>
      {%- if order.shipping_method -%}
        <p><strong>Shipping:</strong> {{ order.shipping_method.title }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---- Items table with product thumbnails ---- {%- endcomment -%}
  <div class="items-section">
    <h3>Items</h3>
    <table class="items">
      <thead>
        <tr>
          <th class="thumb"></th>
          <th>Description</th>
          <th class="qty">Qty</th>
          <th class="price">Price</th>
        </tr>
      </thead>
      <tbody>
        {%- for line in order.line_items -%}
          <tr>
            <td class="thumb">
              <div class="img-wrap">
                {%- if line.image -%}
                  <img src="{{ line.image | img_url: '200x' }}" alt="{{ line.title | escape }}">
                {%- endif -%}
              </div>
            </td>
            <td>
              {{ line.title }}
              {%- if line.variant_title and line.variant_title != "Default Title" %}
                <span class="variant">{{ line.variant_title }}</span>
              {%- endif -%}
            </td>
            <td class="qty">× {{ line.quantity }}</td>
            <td class="price">{{ line.line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="total-row">
      <div class="total-box">
        <span class="label">Total</span>
        <span class="amount">{{ order.total_price | money }}</span>
      </div>
    </div>
  </div>

  {%- comment -%} ---- Repeat-customer discount ---- {%- endcomment -%}
  <div class="discount">
    <div class="icon">🦦</div>
    <div class="body">
      <div class="label">A thank-you from the otter</div>
      <div class="copy">
        Enjoy <strong>20% off</strong> your next order with code
        <span class="code">OTTERLOVE20</span>
        — minimum spend £10.
      </div>
    </div>
  </div>

  {%- comment -%} ---- Footer ---- {%- endcomment -%}
  <div class="footer">
    <div class="row">
      Questions? <span class="support"><a href="mailto:support@otterseas.com">support@otterseas.com</a></span> · 30-day returns
    </div>
    <div class="brand">Otterseas · otterseas.com</div>
  </div>

</div>
</body>
</html>

{%- comment -%}
==============================================================================
  Otterseas Packing Slip — Shopify Order Printer template
==============================================================================
  Lightly branded version of the standard slip:
  - Wordmark + thin accent line at the top
  - Brand-blue headings, otherwise neutral typography
  - Clean order details, items table, total, ship-to
  - Short thank-you line
  - Brand tag in the footer

  How to use:
  1. In Shopify admin → Apps → Order Printer → Templates → New
  2. Paste the entire contents of this file into the template body
  3. Save and set as the default packing-slip template (optional)

  Tuned for A4. Single page in almost all cases.
==============================================================================
{%- endcomment -%}

<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Packing Slip · {{ order.name }}</title>
<style>
  @page { size: A4 portrait; margin: 14mm; }
  * { box-sizing: border-box; }
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #1a1a1a;
    margin: 0;
    padding: 0;
    font-size: 10.5pt;
    line-height: 1.5;
  }
  .page { width: 100%; max-width: 182mm; margin: 0 auto; }

  /* ---------- Header ---------- */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 10px;
    border-bottom: 1.5px solid #023859;
    margin-bottom: 24px;
  }
  .wordmark {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 800;
    font-size: 20pt;
    letter-spacing: 0.18em;
    color: #023859;
    text-transform: uppercase;
  }
  .wordmark .tag {
    display: block;
    font-size: 7pt;
    letter-spacing: 0.32em;
    color: #54ACBF;
    margin-top: 2px;
    font-weight: 600;
  }
  .order-meta { text-align: right; font-size: 10pt; color: #555; }
  .order-meta .label {
    font-size: 7pt;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
  }
  .order-meta .value { color: #023859; font-weight: 600; font-size: 11pt; }
  .order-meta .row { margin-bottom: 4px; }

  /* ---------- Thanks line ---------- */
  .thanks {
    font-size: 12pt;
    color: #023859;
    margin-bottom: 22px;
    font-weight: 500;
  }
  .thanks strong { font-weight: 700; }

  /* ---------- Two-column meta (Ship to + Order details) ---------- */
  .meta-grid {
    display: flex;
    gap: 24px;
    margin-bottom: 24px;
  }
  .meta-block { flex: 1; }
  .meta-block h3 {
    font-size: 8pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #023859;
    font-weight: 700;
    margin: 0 0 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid #023859;
  }
  .meta-block p { margin: 2px 0; font-size: 10.5pt; color: #1a1a1a; }

  /* ---------- Items table ---------- */
  .items-section h3 {
    font-size: 8pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #023859;
    font-weight: 700;
    margin: 0 0 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid #023859;
  }
  table.items {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
  }
  table.items th {
    text-align: left;
    font-size: 8pt;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
    padding: 8px 4px;
    border-bottom: 1px solid #ddd;
  }
  table.items th.qty { text-align: center; width: 60px; }
  table.items th.price { text-align: right; width: 80px; }
  table.items td {
    padding: 10px 4px;
    border-bottom: 1px dotted #ddd;
    font-size: 10.5pt;
    vertical-align: top;
  }
  table.items td.qty { text-align: center; color: #555; }
  table.items td.price { text-align: right; font-weight: 600; }
  table.items .variant {
    display: block;
    font-size: 9pt;
    color: #777;
    margin-top: 2px;
  }

  /* ---------- Total ---------- */
  .total-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 10px;
  }
  .total-row .total-box {
    min-width: 200px;
    border-top: 2px solid #023859;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .total-row .label {
    font-size: 9pt;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #023859;
    font-weight: 700;
  }
  .total-row .amount {
    font-size: 14pt;
    font-weight: 800;
    color: #023859;
  }

  /* ---------- Footer ---------- */
  .footer {
    margin-top: 36px;
    padding-top: 14px;
    border-top: 1px solid #ddd;
    text-align: center;
    font-size: 9pt;
    color: #666;
  }
  .footer .row { margin-bottom: 4px; }
  .footer .support a { color: #023859; font-weight: 600; text-decoration: none; }
  .footer .brand {
    margin-top: 10px;
    font-size: 8pt;
    letter-spacing: 0.32em;
    color: #023859;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
</head>
<body>
<div class="page">

  {%- comment -%} ---- Header ---- {%- endcomment -%}
  <div class="header">
    <div class="wordmark">
      Otterseas
      <span class="tag">Memories That Stick</span>
    </div>
    <div class="order-meta">
      <div class="row">
        <div class="label">Order</div>
        <div class="value">{{ order.name }}</div>
      </div>
      <div class="row">
        <div class="label">Date</div>
        <div class="value">{{ order.created_at | date: "%-d %B %Y" }}</div>
      </div>
    </div>
  </div>

  {%- comment -%} ---- Thanks ---- {%- endcomment -%}
  <div class="thanks">
    Hi <strong>{{ order.customer.first_name | default: "diver" }}</strong>, thanks for your order — everything you need is packed inside.
  </div>

  {%- comment -%} ---- Two-column: ship to + summary ---- {%- endcomment -%}
  <div class="meta-grid">
    <div class="meta-block">
      <h3>Ship to</h3>
      <p><strong>{{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}</strong></p>
      <p>{{ order.shipping_address.address1 }}</p>
      {%- if order.shipping_address.address2 -%}
        <p>{{ order.shipping_address.address2 }}</p>
      {%- endif -%}
      <p>
        {{ order.shipping_address.city }}{% if order.shipping_address.province %}, {{ order.shipping_address.province }}{% endif %} {{ order.shipping_address.zip }}
      </p>
      <p>{{ order.shipping_address.country }}</p>
    </div>
    <div class="meta-block">
      <h3>Order summary</h3>
      <p><strong>Order:</strong> {{ order.name }}</p>
      <p><strong>Date:</strong> {{ order.created_at | date: "%-d %B %Y" }}</p>
      <p><strong>Items:</strong> {{ order.line_items | sum: "quantity" }}</p>
      {%- if order.shipping_method -%}
        <p><strong>Shipping:</strong> {{ order.shipping_method.title }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---- Items table ---- {%- endcomment -%}
  <div class="items-section">
    <h3>Items</h3>
    <table class="items">
      <thead>
        <tr>
          <th>Description</th>
          <th class="qty">Qty</th>
          <th class="price">Price</th>
        </tr>
      </thead>
      <tbody>
        {%- for line in order.line_items -%}
          <tr>
            <td>
              {{ line.title }}
              {%- if line.variant_title and line.variant_title != "Default Title" %}
                <span class="variant">{{ line.variant_title }}</span>
              {%- endif -%}
            </td>
            <td class="qty">× {{ line.quantity }}</td>
            <td class="price">{{ line.line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="total-row">
      <div class="total-box">
        <span class="label">Total</span>
        <span class="amount">{{ order.total_price | money }}</span>
      </div>
    </div>
  </div>

  {%- comment -%} ---- Footer ---- {%- endcomment -%}
  <div class="footer">
    <div class="row">
      Questions? <span class="support"><a href="mailto:support@otterseas.com">support@otterseas.com</a></span> · 30-day returns
    </div>
    <div class="brand">Otterseas · otterseas.com</div>
  </div>

</div>
</body>
</html>
